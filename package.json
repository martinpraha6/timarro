{
  "name": "timarro",
  "version": "0.2.0",
  "description": "Framework-agnostic web component for rendering historical timelines — <timarro-timeline>.",
  "keywords": [
    "timeline",
    "web-component",
    "custom-element",
    "visualization",
    "history",
    "events"
  ],
  "homepage": "https://github.com/martinpraha6/timarro#readme",
  "bugs": "https://github.com/martinpraha6/timarro/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinpraha6/timarro.git"
  },
  "license": "MIT",
  "author": "Martin Sevcik <martin@isevcik.cz>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "register": [
        "./dist/register.d.ts"
      ],
      "schema": [
        "./dist/schema/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/timarro.min.js",
  "jsdelivr": "./dist/timarro.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.cjs",
    "./dist/timarro.min.js"
  ],
  "scripts": {
    "build": "tsdown",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:package": "publint && attw --pack .",
    "demo": "vite demo",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm size && pnpm check:bundle && pnpm check:package",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "size-limit": [
    {
      "path": "dist/timarro.min.js",
      "limit": "25 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@size-limit/file": "^13.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "size-limit": "^13.0.1",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
