{
  "name": "timarro",
  "version": "0.0.1",
  "description": "Framework-agnostic web component for rendering historical timelines — <timarro-timeline>.",
  "keywords": [
    "timeline",
    "web-component",
    "custom-element",
    "visualization",
    "history",
    "events"
  ],
  "homepage": "https://github.com/martinpraha6/timarro#readme",
  "bugs": "https://github.com/martinpraha6/timarro/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinpraha6/timarro.git"
  },
  "license": "MIT",
  "author": "Martin Sevcik <martin@isevcik.cz>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "register": [
        "./dist/register.d.ts"
      ],
      "schema": [
        "./dist/schema/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/timarro.min.js",
  "jsdelivr": "./dist/timarro.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.cjs",
    "./dist/timarro.min.js"
  ],
  "scripts": {
    "build": "tsup",
    "check:bundle": "node scripts/check-bundle.mjs",
    "demo": "vite demo",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm check:bundle",
    "size": "size-limit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "size-limit": [
    {
      "path": "dist/timarro.min.js",
      "limit": "25 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
